{
  "name": "ytdigest-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test": "vitest run",
    "coverage": "vitest run --coverage --testTimeout=15000",
    "pretest:e2e": "npm run typecheck:e2e",
    "test:e2e": "playwright test",
    "test:e2e:real-embed": "npm run typecheck:e2e && E2E_REAL_EMBED=1 playwright test --project=real-embed",
    "gen:api": "node scripts/api-types.mjs",
    "gen:api:check": "node scripts/api-types.mjs --check",
    "prebuild": "npm run gen:api",
    "lint": "eslint . --max-warnings=0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/babel__core": "7.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
