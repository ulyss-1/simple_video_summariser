# Copy to .env for local development (`cp .env.example .env`), then fill in
# real values. .env is gitignored — never commit real secrets.
#
# Every variable compose.yml interpolates is listed here with its default
# (the value compose.yml and common/config.py use when it is unset).

# Required by compose.yml's db service; `docker compose up -d db` refuses to
# start without it (architecture.md 11.4, 11.5). It is inserted unencoded
# into DATABASE_URL, so use only [A-Za-z0-9_-].
POSTGRES_PASSWORD=changeme

# Host ports (loopback only). Override them, or set one empty to let Docker
# pick a free port, so a second compose project can run beside a stack that
# already holds the default: `WEB_HOST_PORT= docker compose -p other up -d`.
# WEB_HOST_PORT is nginx (production); DB_HOST_PORT and WEB_DEV_PORT are the
# dev overlay's Postgres and Vite server. Find a picked one with
# `docker compose -p other port web 8080`.
WEB_HOST_PORT=8080
DB_HOST_PORT=5432
WEB_DEV_PORT=5173

# Shared by planner, analyzer and transcriber (the transcriber builds the
# `analyze` dedupe key from PROMPT_VERSION and SUMMARIZER).
SUMMARIZER=ollama
ANTHROPIC_BATCH=1
PROMPT_VERSION=v1
CHUNK_SEC=900
OVERLAP_SEC=60

# planner
POLL_INTERVAL_SEC=3600
RECONCILE_INTERVAL_SEC=21600
AUDIO_TTL_DAYS=30
# Re-analysis sweep with SUMMARIZER=anthropic: the most sweep jobs ever enqueued
# for one PROMPT_VERSION (a cumulative count, not per run); 0 = none (#99).
SWEEP_MAX_JOBS_ANTHROPIC=100
# The same sweep's USD budget per PROMPT_VERSION (#153); whichever of the two
# caps binds first stops it; 0 = none. Only read with SUMMARIZER=anthropic.
SWEEP_MAX_USD_ANTHROPIC=2.50

# planner and transcriber: skip YouTube Shorts found by RSS polling or channel
# backfill (#80). 0 = include them (the default); 1 = record them as
# unavailable='short' and never process them. A video you submit yourself is
# always processed. Meant to become a per-channel choice later.
SKIP_SHORTS=0

# planner and transcriber
AUDIO_MAX_GB=20
AUDIO_KEEP=1

# planner: evict extra audio when free space on the audio volume falls below
# the larger of these two floors (0 turns a floor off)
AUDIO_MIN_FREE_GB=2
AUDIO_MIN_FREE_PCT=5

# api: Postgres connection pool (#95). api replicas x DB_POOL_MAX_SIZE + workers
# + planner + migrate must stay below Postgres max_connections (default 100).
# MIN <= MAX; TIMEOUT is in seconds, at most 4 (the healthcheck timeout is 5).
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_TIMEOUT_SEC=2

# analyzer
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
ANTHROPIC_MODEL=claude-haiku-4-5
# Ollama context window (#389), analyzer only. It must hold the chunk prompt
# plus the reply: a 15-minute chunk of dense speech is about 5.6k to 6.0k
# prompt tokens and needs up to about 2.6k tokens of reply, so 8192 ran out of
# context on some videos (#382). At 16384 the adapter's chunk budget also grows
# (to about 14 000 tokens), so chunks are larger and calls are slower.
# Memory: the cost is the KV cache of the model the host's Ollama keeps loaded,
# not the analyzer container. Measured in #382 with the transcriber stopped, on
# the 14 GB host: peak used memory 9.8 to 10.5 GB for qwen3.5:4b and 12.8 to
# 13.1 GB for gemma4:e4b (the alternative model) at 16384, against 8.8 to
# 10.5 and 12.3 to 12.9 GB at 8192, i.e. up to about 1 GB more. Running beside
# the Whisper transcriber was not measured.
# The reserve must stay below the context, otherwise the analyzer fails at
# startup (#85); lowering OLLAMA_NUM_CTX to 2048 or less needs a lower reserve
# too. An empty value falls back to the default. The host CLI and eval harness
# read these from the shell environment, not from this file.
OLLAMA_NUM_CTX=8192
OLLAMA_OUTPUT_RESERVE_TOKENS=2048
OLLAMA_TIMEOUT_SEC=900
# Whole-job cap for one analyze job, analyzer only: a handler past it is
# treated as hung and the worker exits. Keep it above the expected time of the
# longest video (about 1 s of model time per second of video on this CPU at
# 16384). OLLAMA_TIMEOUT_SEC stays the per-call cap.
ANALYZE_MAX_RUNTIME_SEC=3600
# Only the analyzer receives it. Leave empty unless SUMMARIZER=anthropic.
ANTHROPIC_API_KEY=
# SUMMARIZER=free (#364): tries the free-tier providers of
# adapters/summarize/free_providers.toml in order, skipping any without a key.
# The transcript text is sent to the provider that answers. Set at least one.
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
# Puter auth token (puter.com/dashboard, Create token): Gemma 4 is free; treat the token like a password.
PUTER_AUTH_TOKEN=
# SUMMARIZER=free (#392): 1 keeps the last provider of the list, the local
# Ollama (model gemma4:e4b, from free_providers.toml), used for a call only when
# every remote provider failed. Needs `ollama pull gemma4:e4b` on the host,
# OLLAMA_NUM_CTX=16384 (a lower value makes every call's chunks smaller and logs
# a warning at startup) and a raised ANALYZE_MAX_RUNTIME_SEC (gemma takes 62 to
# 75 s per minute of video). While a job uses it, the transcriber is paused.
FREE_LLM_LOCAL_FALLBACK=0
# Opt-in compose.anthropic.yml host secret path; no default. Do not set both.
ANTHROPIC_API_KEY_FILE=

# transcriber
WHISPER_MODEL=large-v3
WHISPER_COMPUTE=int8
# Keep WHISPER_THREADS at or below TRANSCRIBER_CPUS: more threads than the
# CPU quota only oversubscribe it.
WHISPER_THREADS=3
PREFER_WHISPER=0
AUTO_CAPTION_FALLBACK=1
MAX_ATTEMPTS_TRANSCRIBE=2
# CPU limit for the transcriber container. Must not exceed the host's CPU
# count, or Docker rejects the container.
TRANSCRIBER_CPUS=3.0
