# copy to <scratch>/env.sh; tools/run.sh sources it. Settings of the live analyzer (code defaults).
# OLLAMA_HOST here is the Settings value (a URL). The ollama CLI needs OLLAMA_HOST=172.17.0.1:11434 set inline.
export DATABASE_URL="postgresql://ytdigest:${DBPASS}@127.0.0.1:55432/ytdigest"   # throwaway container only
export OLLAMA_HOST="${OLLAMA_HOST_OVERRIDE:-http://172.17.0.1:11434}"
export SUMMARIZER=ollama
export OLLAMA_NUM_CTX="${OLLAMA_NUM_CTX:-8192}"
export OLLAMA_OUTPUT_RESERVE_TOKENS=2048
export OLLAMA_TIMEOUT_SEC=900
export CHUNK_SEC=900
export OVERLAP_SEC=60
export PROMPT_VERSION=v1
export LOG_FORMAT=json
