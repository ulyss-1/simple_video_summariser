
{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

{
  "hooks": {
        "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai_docs_status.py\"",
            "timeout": 15
          }
        ]
      }
    ],

    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path' | xargs npx prettier --write 2>/dev/null; exit 0"
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/ai_docs_nudge.py\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
},
  "permissions": {
    "allow": [
      "Bash(npm test *)"
    ]
  }
}
