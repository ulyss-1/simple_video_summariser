# Backend image (architecture.md 11.3): one image for migrate, planner,
# analyzer and (later) api; the services differ only by their command.
# Build from the repo root:
#   docker build -f ops/Dockerfile.backend -t ytdigest-backend:latest .

# ---- builder ----
FROM python:3.14-slim@sha256:35caba83af2fe6da9a5d922f9b0156f21d1246a48278c58a08bd253303ba42e8 AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /build
# The lock comes before any application code, so editing a source file never
# invalidates this layer. It is generated from requirements.backend.txt
# (scripts/lock_requirements.py, #145) and pins every package, transitive ones
# included, with the sha256 of every published file. --require-hashes makes pip
# refuse anything else, --no-deps stops it resolving, `pip check` fails the
# build on a broken dependency set.
COPY requirements.backend.lock .
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --require-hashes --no-deps -r requirements.backend.lock && \
    /opt/venv/bin/pip check

# ---- runtime ----
FROM python:3.14-slim@sha256:35caba83af2fe6da9a5d922f9b0156f21d1246a48278c58a08bd253303ba42e8
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONPATH=/app
# /data/audio is created here, owned by app: a named volume mounted over it
# copies this ownership on first use, so the planner can unlink purged files.
RUN useradd -r -u 10001 -m app && \
    mkdir -p /data/audio && chown -R app:app /data
WORKDIR /app
COPY --chown=app:app common/ ./common/
COPY --chown=app:app adapters/ ./adapters/
COPY --chown=app:app services/ ./services/
COPY --chown=app:app migrations/ ./migrations/
COPY --chown=app:app alembic.ini .
RUN chown app:app /app
USER app
# No ENTRYPOINT and no HEALTHCHECK: compose supplies the command and the
# healthcheck. The command runs as PID 1 and receives SIGTERM directly.
