# Backend image (architecture.md 11.3): one image for migrate, planner,
# analyzer and (later) api; the services differ only by their command.
# Build from the repo root:
#   docker build -f ops/Dockerfile.backend -t ytdigest-backend:latest .
# The `deps` stage holds everything except application code (#135).
# ops/Dockerfile.whisper builds on it, so a code change never invalidates the
# whisper install. Build it alone, as compose's build-only `deps` service does:
#   docker build -f ops/Dockerfile.backend --target deps --provenance=false -t ytdigest-deps:latest .
# The last stage stays the default target.

# ---- deno ----
# The JavaScript runtime yt-dlp uses to solve YouTube's player challenges
# (#134). The official image holds only the binary; written as a FROM, its
# digest is checked by scripts/base_image_digest_check.py. Moves together with
# yt-dlp and yt-dlp-ejs (requirements.backend.txt); yt-dlp 2026.10.21 asks for
# deno>=2.9.8.
FROM denoland/deno:bin-2.9.8@sha256:b507583d3c68ba69f3ed2ce5969ae5b8b70f43421c781279c7aea06435263543 AS deno

# ---- builder ----
FROM python:3.14-slim@sha256:cd89c30eda26ee911a4611b18680086e0ea42e6f5f8cbe653d07fa7958c9cec8 AS builder
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential && rm -rf /var/lib/apt/lists/*
WORKDIR /build
# The lock comes before any application code, so editing a source file never
# invalidates this layer. It is generated from requirements.backend.txt
# (scripts/lock_requirements.py, #145) and pins every package, transitive ones
# included, with the sha256 of every published file. --require-hashes makes pip
# refuse anything else, --no-deps stops it resolving, `pip check` fails the
# build on a broken dependency set.
COPY requirements.backend.lock .
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --require-hashes --no-deps -r requirements.backend.lock && \
    /opt/venv/bin/pip check

# ---- deps: runtime base, no application code ----
FROM python:3.14-slim@sha256:cd89c30eda26ee911a4611b18680086e0ea42e6f5f8cbe653d07fa7958c9cec8 AS deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg curl && rm -rf /var/lib/apt/lists/*
COPY --from=builder /opt/venv /opt/venv
# Deno layer: before the application COPYs, so editing a source file keeps it
# cached. Nothing is fetched at runtime; the solver scripts are yt-dlp-ejs in
# the venv.
COPY --from=deno /deno /usr/local/bin/deno
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONPATH=/app
# /data/audio is created here, owned by app: a named volume mounted over it
# copies this ownership on first use, so the planner can unlink purged files.
RUN useradd -r -u 10001 -m app && \
    mkdir -p /data/audio && chown -R app:app /data
WORKDIR /app

# ---- runtime: deps plus application code (the default, last target) ----
FROM deps AS runtime
COPY --chown=app:app common/ ./common/
COPY --chown=app:app adapters/ ./adapters/
COPY --chown=app:app services/ ./services/
COPY --chown=app:app migrations/ ./migrations/
COPY --chown=app:app alembic.ini .
RUN chown app:app /app
USER app
# No ENTRYPOINT and no HEALTHCHECK: compose supplies the command and the
# healthcheck. The command runs as PID 1 and receives SIGTERM directly.
